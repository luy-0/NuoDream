# Copy this file to .env.local and use a newly rotated key. Never commit .env.local.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Jev two-choice matching. Server-only: never prefix with NEXT_PUBLIC and never
# commit a real value (use .env.local for the local temporary key).
openrouter_jev_key=
